# ════════════════════════════════════════════════════════════════════════════════════════
#  Robinson's Toolkit MCP v2.0 — Complete Environment Configuration
#  
#  A comprehensive guide to all available services and API integrations.
#  
#  QUICK START:
#  1. Copy this file: cp .env.example .env
#  2. Get API keys from the URLs listed below
#  3. Paste keys next to their variable names
#  4. Run: npm start
#
#  KEY POINTS:
#  • Leave any variable blank if you don't need that service
#  • Blank variables just mean that service won't be available
#  • NEVER commit .env to GitHub (add to .gitignore)
#  • Use different keys for dev/test vs production
#  • Rotate keys quarterly as a security best practice
#
#  ORGANIZATION OF THIS FILE:
#  1. Core workspace setup (REQUIRED)
#  2. Version control & deployments (GitHub, Vercel, Fly.io)
#  3. Cloud infrastructure (Cloudflare, Linear, Slack)
#  4. Databases & data storage (Neon, PostgreSQL, Supabase, Upstash, Qdrant)
#  5. Authentication & monitoring (Clerk, Sentry)
#  6. AI & language models (OpenAI, Anthropic, Gemini, web search)
#  7. Payment processing (Stripe)
#  8. Communication & mapping (Twilio, Resend, Mapbox)
#  9. Specialty services (Context7, N8N, Linear)
#  10. Google Workspace integration (Gmail, Drive, Calendar, Docs, etc.)
#  11. Local & always-available tools (no API keys required)
#
# ════════════════════════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════════════════════════
#  1️⃣  CORE WORKSPACE CONFIGURATION — REQUIRED FOR ALL FILE OPERATIONS
# ════════════════════════════════════════════════════════════════════════════════════════

# Where Claude is allowed to read and write files
# Update this to match your actual project directory
# Examples:
#   • Linux/Mac: /home/user/projects or /Users/username/workspace
#   • Windows: C:\\Users\\Username\\Projects (or use WSL2 path)
#   • WSL2: /home/robinson_dev/projects
WORKSPACE_ROOT="/home/robinson_dev/projects"

# Optional: Restrict writing to specific folders (prevents accidental changes elsewhere)
# Leave blank to allow writes everywhere under WORKSPACE_ROOT
# Example: ALLOWED_WRITE_PATHS="src,config,data" would only allow writes to ./src, ./config, ./data
ALLOWED_WRITE_PATHS=


# ════════════════════════════════════════════════════════════════════════════════════════
#  2️⃣  VERSION CONTROL & DEPLOYMENT PLATFORMS
#     The core tools for shipping code and managing releases
# ════════════════════════════════════════════════════════════════════════════════════════

# ── GITHUB (Code repository management & automation) ─────────────────────────────────────
# Get a Personal Access Token at: https://github.com/settings/tokens
# Click "Generate new token (classic)" → give it these scopes:
#   ✓ repo (full control of private repositories)
#   ✓ workflow (update GitHub Actions)
#   ✓ read:org (read team membership)
#   ✓ admin:repo_hook (manage webhooks)
# Token format: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_TOKEN=

# Alternate variable name (both are supported):
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── VERCEL (Serverless deployment, edge functions, preview URLs) ────────────────────────
# Get tokens at: https://vercel.com/account/tokens
# Click "Create" → give it "Production" and "Preview" access
# Scope: Full account access recommended for development
VERCEL_TOKEN=

# Optional: if you're part of a Vercel Team/Organization
# Find at: https://vercel.com/account/teams (under Team Settings)
# Format: team_xxxxxxxxxxxxxx
VERCEL_TEAM_ID=

# ── FLY.IO (Container deployment, global availability) ───────────────────────────────────
# Install CLI first: curl -L https://fly.io/install.sh | sh
# Then generate token: fly tokens create deploy -x 999999h
# This gives you a 999-hour valid deploy token (long-lived for CI/CD)
FLY_API_TOKEN=


# ════════════════════════════════════════════════════════════════════════════════════════
#  3️⃣  CLOUD INFRASTRUCTURE & TEAM COORDINATION
#     CDN, DNS, security, issue tracking, and team chat
# ════════════════════════════════════════════════════════════════════════════════════════

# ── CLOUDFLARE (CDN, DNS management, WAF, Workers, R2 storage, D1 database) ─────────────
# API Token: https://dash.cloudflare.com/profile/api-tokens
#   → "Create Token" → use "Edit Cloudflare Workers" template (recommended)
#   OR create a custom token with permissions: Account Resources (All zones), User
# Token format: v1.0-xxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=

# Account ID: https://dash.cloudflare.com/profile/api-tokens
#   Look for "Account ID" field on this page (32-char hex string)
# Format: 1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p
CLOUDFLARE_ACCOUNT_ID=

# ── LINEAR (Issues, project planning, feature tracking) ──────────────────────────────────
# Get API key at: https://linear.app (in your workspace)
#   → Settings → API → Personal API keys → Create Key
# This enables creating issues, tracking features, managing sprints
# Format: lin_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINEAR_API_KEY=

# ── SLACK (Team notifications, alerts, direct messages) ────────────────────────────────
# Create a bot at: https://api.slack.com/apps
#   → "Create New App" → "From scratch" → name it (e.g., "Robinson's Bot")
#   → OAuth & Permissions → add scopes:
#       • chat:write (send messages)
#       • chat:write.public (post to public channels)
#       • channels:manage (create channels if needed)
#       • channels:read (list channels)
# Get the "Bot User OAuth Token" (starts with xoxb-)
# Bot credential for ordinary workspace operations.
SLACK_BOT_TOKEN=

# Enterprise organization admin user token with admin.conversations:write.
# Used only for explicitly requested admin operations; never substitute the bot token.
SLACK_ADMIN_TOKEN=

# Optional: Default channel for notifications
# Format: #channel-name or channel-id (C123456789ABC)
SLACK_DEFAULT_CHANNEL=


# ════════════════════════════════════════════════════════════════════════════════════════
#  4️⃣  DATABASES & DATA STORAGE
#     Choose one or combine multiple for different use cases
# ════════════════════════════════════════════════════════════════════════════════════════

# ── NEON (PostgreSQL serverless — easiest to get started) ───────────────────────────────
# Best for: startups, side projects, rapid prototyping
# Get started: https://console.neon.tech → Sign up (free tier available!)
# API key: Account → API keys → Create API key
# Format: [neon_api_key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx]
NEON_API_KEY=

# Organization ID: https://console.neon.tech → Settings → Org ID
# Format: org_xxxxxxxxx
NEON_ORG_ID=

# Connection string is auto-generated by Neon
# Format: postgresql://neondb_user:password@ep-xxxx-region.neon.tech/neondb
# You can get this from the Neon dashboard
NEON_DATABASE_URL=

# ── POSTGRES (Direct connection to any PostgreSQL database) ────────────────────────────
# Use this for self-hosted, Docker, AWS RDS, DigitalOcean, Azure, etc.
# Connection string format: postgresql://user:password@host:port/database
# Example: postgresql://postgres:mypassword@localhost:5432/myapp
# Note: for production, use SSL mode: postgresql://...?sslmode=require
POSTGRES_CONNECTION_STRING=

# ── SUPABASE (PostgreSQL + Realtime features + built-in Auth) ────────────────────────
# Modern Firebase alternative with Postgres at its core
# Get at: https://app.supabase.com → Project Settings → API
# Project URL format: https://xxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Supabase public API key (safe to expose in browser):
SUPABASE_KEY=

# Supabase anonymous/public key:
SUPABASE_ANON_KEY=

# Service role key (SECRET - never expose in frontend):
# Project API credential; not a Management API token.
SUPABASE_SERVICE_ROLE_KEY=

# Management API personal access token or OAuth access token (projects, logs, etc.)
SUPABASE_ACCESS_TOKEN=

# ── UPSTASH (Serverless Redis cache, Vector store, Kafka queue) ───────────────────────
# Get started: https://console.upstash.com
# Great for caching, rate limiting, real-time features

# Redis REST API:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Advanced admin operations (optional):
UPSTASH_API_KEY=
UPSTASH_EMAIL=

# Vector store for embeddings & semantic search:
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Kafka for event streaming & async processing:
UPSTASH_KAFKA_REST_URL=
UPSTASH_KAFKA_REST_TOKEN=

# ── QDRANT (Vector database for AI/ML similarity search) ──────────────────────────────
# Used for semantic search, RAG (Retrieval Augmented Generation), recommendations
# Local instance: http://localhost:6333
# Cloud: https://your-cluster.qdrant.io
# Get started: https://qdrant.tech/documentation/quick-start/
QDRANT_URL=

# Only needed if your Qdrant instance is password-protected:
QDRANT_API_KEY=


# ════════════════════════════════════════════════════════════════════════════════════════
#  5️⃣  USER AUTHENTICATION & ERROR MONITORING
#     Who can access your app + tracking when things break
# ════════════════════════════════════════════════════════════════════════════════════════

# ── CLERK (User authentication, social login, 2FA) ────────────────────────────────────
# Fast alternative to Auth0 · Get at: https://dashboard.clerk.com
#   → API Keys → Copy Secret Key
# Handles: email/password, OAuth (Google, GitHub, Twitter), 2FA, user sessions
# Format: sk_STRIPE_KEY_HERE
CLERK_SECRET_KEY=

# ── SENTRY (Error tracking, performance monitoring, source maps) ───────────────────────
# Catch bugs automatically before users report them
# Get at: https://sentry.io → Settings → Auth Tokens (Account level)
# Format: sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_AUTH_TOKEN=

# Your Sentry organization slug (visible in Sentry dashboard URL):
# Example: if your URL is https://sentry.io/organizations/my-org/, the slug is "my-org"
SENTRY_ORG_SLUG=

# Optional: default project slug for auto-linking:
SENTRY_PROJECT_SLUG=


# ════════════════════════════════════════════════════════════════════════════════════════
#  6️⃣  AI & LANGUAGE MODELS
#     Use one, mix multiple, or fall back to local models (no cost with Ollama)
# ════════════════════════════════════════════════════════════════════════════════════════

# ── OPENAI (GPT-4, GPT-4 Turbo, GPT-3.5-Turbo) ──────────────────────────────────────
# Get API key: https://platform.openai.com/api-keys
# Set usage limits to avoid surprise bills: https://platform.openai.com/account/billing/limits
# Format: sk_OPENAI_KEY_HERE
OPENAI_API_KEY=

# Optional: separate key for sensitive operations (file uploads, etc.):
OPENAI_ADMIN_KEY=

# ── ANTHROPIC (Claude 3.5 Sonnet, Claude 3 Opus, Claude 3 Haiku) ──────────────────────
# Get API key: https://console.anthropic.com → API keys
# Claude is strong at reasoning, code, and long-form content
# Format: sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=

# Optional: separate admin key:
ANTHROPIC_ADMIN_KEY=

# ── GOOGLE GEMINI (Text, images, audio, video, PDF analysis) ─────────────────────────
# Multimodal LLM from Google · Get key: https://aistudio.google.com/app/apikey
# Can process: text, images, PDFs, audio, video
GEMINI_API_KEY=

# ── MOONSHOT / KIMI (Chinese LLM alternative) ───────────────────────────────────────
# Alternative provider if you need different capabilities or have geo restrictions
# Get key: https://platform.moonshot.cn/
MOONSHOT_API_KEY=

# ── VOYAGE AI (High-quality text embeddings for semantic search) ──────────────────────
# Better than OpenAI embeddings for finding similar documents/text
# Get key: https://www.voyageai.com/
VOYAGE_API_KEY=

# ── WEB SEARCH & RESEARCH TOOLS (keep current with the internet) ──────────────────────
# Use these to search the web, find current news, verify facts

# Brave Search (privacy-focused, no tracking):
# Get key: https://api.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=

# Tavily (AI research & web search):
# Get key: https://app.tavily.com
TAVILY_API_KEY=

# SerpAPI (Google search results):
# Get key: https://serpapi.com/dashboard
SERPAPI_KEY=


# ════════════════════════════════════════════════════════════════════════════════════════
#  7️⃣  STRIPE PAYMENTS
#     Accept credit cards, subscriptions, invoices, payouts
# ════════════════════════════════════════════════════════════════════════════════════════

# Get at: https://dashboard.stripe.com/apikeys
# IMPORTANT: Use different keys for test vs live!
#   • Development: sk_test_... (uses fake credit cards 4242 4242 4242 4242)
#   • Production: sk_live_... (real money! use with caution)
# Format: sk_STRIPE_KEY_HERE
STRIPE_SECRET_KEY=

# Publishable key (safe to expose in frontend):
STRIPE_PUBLISHABLE_KEY=


# ════════════════════════════════════════════════════════════════════════════════════════
#  8️⃣  COMMUNICATION & MAPPING SERVICES
#     SMS, email delivery, location-based services
# ════════════════════════════════════════════════════════════════════════════════════════

# ── TWILIO (SMS, voice calls, WhatsApp, video) ─────────────────────────────────────────
# Get at: https://console.twilio.com → Account → Settings
# Format: ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCOUNT_SID=

# Auth token (SECRET):
TWILIO_AUTH_TOKEN=

# Optional: Your Twilio phone number (format: +1234567890)
TWILIO_PHONE_NUMBER=

# Optional: Service SID for 2FA/OTP verification codes
# Format: VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=

# ── RESEND (Email delivery — great for transactional emails) ──────────────────────────
# Simple email API for notifications, receipts, welcome emails
# Get key: https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Must be verified in Resend dashboard (e.g., noreply@example.com):
RESEND_FROM=

# ── MAPBOX (Maps, directions, geocoding, search) ──────────────────────────────────────
# Get tokens: https://account.mapbox.com/tokens/
# Format: pk.eyJ... (public) or sk.eyJ... (secret)
MAPBOX_ACCESS_TOKEN=

# Your Mapbox username (for dataset/tileset operations):
MAPBOX_USERNAME=


# ════════════════════════════════════════════════════════════════════════════════════════
#  9️⃣  SPECIALTY & INTEGRATION SERVICES
#     Knowledge APIs, workflow automation
# ════════════════════════════════════════════════════════════════════════════════════════

# ── CONTEXT7 (Knowledge retrieval & documentation indexing) ──────────────────────────
# Get key: https://context7.com/dashboard
CONTEXT7_API_KEY=

# ── N8N (Visual workflow automation, no-code integrations) ────────────────────────────
# Self-hosted or cloud at: https://app.n8n.cloud
# Create workflows that connect multiple services
N8N_BASE_URL=
N8N_ACCESS_TOKEN=

# Alternative credential names:
N8N_API_KEY=


# ════════════════════════════════════════════════════════════════════════════════════════
#  🔟  GOOGLE WORKSPACE INTEGRATION
#     Gmail, Drive, Calendar, Docs, Sheets, Slides, Forms, Contacts
#
#     IMPORTANT: Choose ONE authentication method (personal OR service account)
# ════════════════════════════════════════════════════════════════════════════════════════

# Option A: PERSONAL OAUTH (for your personal Google account)
# Best for: personal projects, single-user applications
# Setup at: https://console.cloud.google.com → Credentials → OAuth 2.0 Client IDs
GOOGLE_ACCESS_TOKEN=

# Option B: SERVICE ACCOUNT (for server/automation, multiple users)
# Best for: production apps, Workspace (G Suite) administration
# Setup at: https://console.cloud.google.com/iam-admin/serviceaccounts
# 
# Step 1: Create a service account
# Step 2: Create a key (JSON format) and download it
# Step 3: Either store the file path OR copy the JSON contents

# Path to the downloaded JSON key file (keep it secure!):
# Example: /home/robinson_dev/robinsons-toolkit-mcp-c9d6517be5c8.json
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# OR: Paste the entire JSON (base64-encoded) for secret management:
GOOGLE_CREDENTIALS_JSON=

# Advanced: Workspace domain-wide delegation (admin impersonation)
# The service account email you're using:
GOOGLE_SERVICE_ACCOUNT_SUBJECT=

# Email to impersonate (requires domain-wide delegation to be enabled):
GOOGLE_USER_EMAIL=
GOOGLE_IMPERSONATE_EMAIL=


# ════════════════════════════════════════════════════════════════════════════════════════
#  1️⃣1️⃣  LOCAL & ALWAYS-AVAILABLE SERVICES
#     These tools work without any API keys — completely free!
# ════════════════════════════════════════════════════════════════════════════════════════

# ── OLLAMA (Run LLMs locally on your computer — completely private & free) ─────────────
# Install from: https://ollama.ai
#
# What it does:
#   • Run models like Llama, Mistral, Qwen, DeepSeek completely offline
#   • No API calls = no costs, no tracking, no internet needed
#   • Perfect for privacy-sensitive work or development without rate limits
#
# Setup:
#   1. Download & install from https://ollama.ai
#   2. Open terminal and run: ollama pull <model-name>
#   3. Set OLLAMA_BASE_URL below
#
# Popular models to try:
#   • ollama pull qwen2.5-coder:7b  (coding, 4.2GB, excellent for programming)
#   • ollama pull llama2 (general purpose, 3.8GB, fast and capable)
#   • ollama pull mistral (quick & smart, 4GB, good all-rounder)
#   • ollama pull neural-chat (chat optimized, 4.8GB, great conversations)
#   • ollama pull deepseek-coder:7b (advanced code generation, 3.8GB)
#
# Connection URLs (choose based on your setup):
#   • Local: http://localhost:11434
#   • Docker: http://host.docker.internal:11434
#   • WSL2 from Windows: http://172.19.16.1:11434
#   • Remote: https://your-ollama-server.com:11434
OLLAMA_BASE_URL=http://172.19.16.1:11434

# Which model to use by default (must be installed first):
# Examples: qwen2.5-coder:7b, llama2, mistral, neural-chat
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# Timeout for requests (in milliseconds):
# Default: 300000 = 5 minutes (increase for slower hardware or large models)
OLLAMA_TIMEOUT_MS=300000

# ── LOCAL FILE OPERATIONS (Always Available — Already Built In) ───────────────────────
# These work without any configuration:
#
#   robinsons-toolkit:local_read_file
#     → Read any file in WORKSPACE_ROOT
#     → Works with code, config, docs, anything text-based
#
#   robinsons-toolkit:local_write_file
#     → Create new files or modify existing ones
#     → Respects ALLOWED_WRITE_PATHS for safety
#
#   robinsons-toolkit:local_list_directory
#     → Browse folders and see what files exist
#     → Shows file sizes and modification dates
#
#   robinsons-toolkit:local_run_command
#     → Execute shell commands: npm, git, python, docker, etc.
#     → Runs inside your WORKSPACE_ROOT
#     → Captures output and errors

# ── PLAYWRIGHT (Browser automation — already installed with toolkit) ──────────────────
# What it does: Control a browser, take screenshots, fill forms, test websites
# Install first: npm install -D playwright
# 
# Common uses:
#   • Web scraping (extract data from websites)
#   • Automated testing (click buttons, check results)
#   • Screenshots (render pages as images)
#   • DOM inspection (query and modify HTML)
#   • Form filling and submission
#   • PDF generation from HTML
# 
# No setup needed beyond npm install — already integrated!

# ── COMPOUND TOOLS (Always Available — Multi-step orchestration) ─────────────────────
# These tools chain multiple services together and are always available:
#
#   robinsons-toolkit:compound_scaffold_feature
#     → Creates: GitHub branch + Neon DB branch + updates .env.local
#     → Replaces ~5 manual steps in 1 call
#     → Automatically runs migrations if configured
#
#   robinsons-toolkit:compound_rollback_transaction
#     → UNDO recent changes to GitHub, Neon, Vercel, Fly, etc.
#     → Safety net if something goes wrong
#     → Can roll back by transaction ID, time range, or count
#
# All operations are logged to the Observability Ledger for safety and auditability


# ════════════════════════════════════════════════════════════════════════════════════════
#  🎯  QUICK REFERENCE: WHICH SERVICES DO WHAT
# ════════════════════════════════════════════════════════════════════════════════════════
#
#  NEED TO...                                    USE THIS SERVICE
#  ─────────────────────────────────────────────────────────────────────────────────────
#  Store user data                               Neon, PostgreSQL, Supabase
#  Cache frequently-used data                    Upstash Redis
#  Find similar documents/embeddings             Qdrant, Upstash Vector
#  Send emails (transactional)                   Resend
#  Send SMS/WhatsApp messages                    Twilio
#  Accept credit card payments                   Stripe
#  Deploy code to the cloud                      Vercel, Fly.io, Cloudflare Workers
#  Manage code repos + run CI/CD                 GitHub
#  Track issues & plan sprints                   Linear
#  Monitor errors in production                  Sentry
#  Authenticate users (login/signup)             Clerk
#  Use AI/LLMs (choose one or more)             OpenAI, Anthropic, Gemini, or Ollama (local)
#  Search the web in real-time                   Brave, Tavily, or SerpAPI
#  Use Google services                           Gmail, Drive, Calendar, Docs, etc.
#  Send team notifications                       Slack
#  Maps & location services                      Mapbox
#  Automate complex workflows                    N8N or Zaps
#  Run LLMs locally (free, private)             Ollama
#  Browser automation & scraping                 Playwright
#  Manage file operations                        Local tools (always available)
#
# ════════════════════════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════════════════════════
#  ⚠️  SECURITY CHECKLIST
# ════════════════════════════════════════════════════════════════════════════════════════
#
#  Before deploying to production:
#
#  ✅ Add .env to .gitignore (prevent accidental commits)
#  ✅ Use separate API keys for dev vs production
#  ✅ Set API usage limits to prevent surprise bills (especially OpenAI!)
#  ✅ Store .env securely:
#       • Encrypted drive or password manager
#       • Never email it
#       • Never paste it in Slack or email
#  ✅ Rotate keys every 3 months (good security practice)
#  ✅ Immediately revoke and replace any leaked keys
#  ✅ Keep production secrets in a secrets manager:
#       • GitHub Secrets (for CI/CD)
#       • Vercel Environment Variables
#       • Fly.io Secrets
#       • AWS Secrets Manager
#       • HashiCorp Vault
#       • 1Password or LastPass (team vaults)
#  ✅ Enable 2FA on all service accounts (GitHub, Vercel, AWS, etc.)
#  ✅ Review API token permissions regularly
#  ✅ Monitor API key usage for unusual activity
#
# ════════════════════════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════════════════════════
#  📊  TESTING YOUR CONFIGURATION
# ════════════════════════════════════════════════════════════════════════════════════════
#
#  After filling in your .env file, run the test suite:
#
#  node test-toolkit.js
#
#  This will check:
#  ✓ All configured services
#  ✓ API key validity
#  ✓ File paths for service account keys
#  ✓ Database connections
#  ✓ Total active tools available
#
# ════════════════════════════════════════════════════════════════════════════════════════
